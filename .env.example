# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Kakao Maps (developers.kakao.com > your app > 플랫폼 키) ---
# JavaScript key. Shown in the browser; protected by the registered domain list.
NEXT_PUBLIC_KAKAO_JS_KEY=
# REST API key. Also used as the client id for "Continue with Kakao".
KAKAO_REST_KEY=

# --- Database (Supabase > Connect > Session pooler URI) ---
DATABASE_URL=

# --- Login ---
# Random secret that signs the login cookie. Generate one with: npx auth secret
AUTH_SECRET=
# Kakao Login client secret (your app > 카카오 로그인 > 보안 > Client Secret, set it to "사용함")
AUTH_KAKAO_SECRET=
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional ---
# Google accounts that become admins when they sign in (comma separated)
ADMIN_EMAILS=
# Shown on the privacy policy page
NEXT_PUBLIC_CONTACT_EMAIL=
